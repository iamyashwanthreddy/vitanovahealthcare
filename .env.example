# Environment variables for the Careers application email notification
# (/api/apply.js on Vercel, /netlify/functions/apply.js on Netlify).
#
# Set these in your hosting provider's dashboard (Vercel → Project →
# Settings → Environment Variables, or Netlify → Site configuration →
# Environment variables) — never commit real values to this repo, and
# never reference them from client-side code.

# REQUIRED. API key from https://resend.com (free tier available).
# The form will return a clear "email service is not configured" error
# on every submission until this is set.
RESEND_API_KEY=

# Where application notifications are sent. Defaults to
# applications@vitanovahealthcare.ie if unset.
APPLICATIONS_TO_EMAIL=applications@vitanovahealthcare.ie

# The verified "from" sender. Resend requires this to be an address on a
# domain you have verified in your Resend account (see
# https://resend.com/domains). Until a domain is verified you can use
# Resend's shared sandbox sender below, but it can only deliver to the
# email address on your own Resend account — fine for testing, not for
# production.
APPLICATIONS_FROM_EMAIL="Vitanova Health Care <onboarding@resend.dev>"
